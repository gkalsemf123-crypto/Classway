    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const floorButtons = document.querySelectorAll('.floor-selection-top .floor-btn');
            floorButtons.forEach(button => {
                button.addEventListener('click', () => {
                    floorButtons.forEach(btn => btn.classList.remove('active'));
                    button.classList.add('active');
                    console.log(`${button.textContent} 층이 선택되었습니다.`);
                });
            });

            const homeLink = document.getElementById('nav-home');
            const classroomLink = document.getElementById('nav-classroom');
            const logoLink = document.querySelector('.logo a');

            const chatbotPromptInput = document.querySelector('.chatbot-prompt-input');
            const sendChatbotBtn = document.querySelector('.send-chatbot-btn');
            const chatDisplay = document.querySelector('.chat-display');

            const homeView = document.querySelector('.content-container');
            const classroomView = document.querySelector('.classroom-container');

            const fileUpload = document.getElementById('fileUpload');
            const fileListContainer = document.getElementById('file-list-container');
            let selectedFiles = [];

            function renderFileList() {
                fileListContainer.innerHTML = '';

                selectedFiles.forEach((file, index) => {
                    const fileDisplay = document.createElement('div');
                    fileDisplay.className = 'file-name-display';

                    const fileSizeInKB = (file.size / 1024).toFixed(1);
                    let sizeText = fileSizeInKB + ' KB';
                    if (fileSizeInKB > 1024) {
                        sizeText = (fileSizeInKB / 1024).toFixed(1) + ' MB';
                    }

                    fileDisplay.innerHTML = `
                        <div class="file-icon">📄</div>
                        <div class="file-name-content">
                            <span class="file-name-text">${file.name}</span>
                            <span class="file-size-text">${sizeText}</span>
                        </div>
                        <button class="file-remove-btn" data-index="${index}" title="파일 삭제">&times;</button>
                    `;

                    fileListContainer.appendChild(fileDisplay);

                    // Trigger animation
                    setTimeout(() => { fileDisplay.classList.add('show'); }, 10);
                });

                document.querySelectorAll('.file-remove-btn').forEach(btn => {
                    btn.addEventListener('click', function () {
                        const idx = parseInt(this.getAttribute('data-index'));
                        const fileDisplay = this.closest('.file-name-display');
                        fileDisplay.classList.remove('show');
                        setTimeout(() => {
                            selectedFiles.splice(idx, 1);
                            updateFileInput();
                            renderFileList();
                        }, 300);
                    });
                });
            }

            function updateFileInput() {
                const dt = new DataTransfer();
                selectedFiles.forEach(file => dt.items.add(file));
                fileUpload.files = dt.files;
            }

            if (fileUpload) {
                fileUpload.addEventListener('change', function () {
                    if (this.files && this.files.length > 0) {
                        Array.from(this.files).forEach(file => {
                            if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
                                selectedFiles.push(file);
                            }
                        });
                        updateFileInput();
                        renderFileList();
                    }
                });
            }

            const mainFloorTabs = document.querySelectorAll('.floor-tab');
            const mainFloorMap = document.getElementById('main-floor-map');
            const floorImages = {
                '1': './floor1_plan.png.png',
                '2': './floor2_plan.png.png',
                '3': './floor3_plan.png.png',
                '4': './floor4.jpg',
                '5': './floor5.jpg',
                '6': './floo6.jpg',
                '7': './floor7.jpg',
                '8': './floor8.jpg',
                '9': './floor9.jpg',
                '10': './floor10.plan.jpg'
            };

            mainFloorTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    mainFloorTabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');
                    mainFloorMap.style.opacity = '0';

                    const pinLayer = document.getElementById('search-pin-layer');
                    if (pinLayer) pinLayer.innerHTML = '';

                    setTimeout(() => {
                        mainFloorMap.src = floorImages[tab.dataset.floor];
                        mainFloorMap.alt = `강의실 ${tab.dataset.floor}층 도면`;

                        if (['1', '2', '3'].includes(tab.dataset.floor)) {
                            mainFloorMap.style.maxHeight = '50vh';
                            mainFloorMap.style.transform = 'none';
                        } else {
                            mainFloorMap.style.maxHeight = '75vh';
                            mainFloorMap.style.transform = 'none';
                        }

                        mainFloorMap.onload = () => {
                            mainFloorMap.style.opacity = '1';
                        };
                    }, 200);
                });
            });
            const noticeView = document.getElementById('notice-view');
            const noticeLink = document.getElementById('nav-notice');

            const boardView = document.getElementById('board-view');
            const freeboardLink = document.getElementById('nav-freeboard');

            // 모바일 네비게이션 버튼
            const mNavHome = document.getElementById('m-nav-home');
            const mNavClassroom = document.getElementById('m-nav-classroom');
            const mNavNotice = document.getElementById('m-nav-notice');
            const mNavBoard = document.getElementById('m-nav-board');

            const allViews = [homeView, classroomView, noticeView, boardView];

            const updateMobileNav = (activeBtn) => {
                [mNavHome, mNavClassroom, mNavNotice, mNavBoard].forEach(btn => {
                    if (btn) btn.classList.remove('active');
                });
                if (activeBtn) activeBtn.classList.add('active');
            };

            const switchView = (viewToShow) => {
                if (!viewToShow || !viewToShow.classList.contains('hidden')) return;

                allViews.forEach(view => {
                    if (view && view !== viewToShow && !view.classList.contains('hidden')) {
                        view.style.opacity = '0';
                        setTimeout(() => {
                            view.classList.add('hidden');
                        }, 400);
                    }
                });

                setTimeout(() => {
                    viewToShow.classList.remove('hidden');
                    requestAnimationFrame(() => {
                        viewToShow.style.opacity = '1';
                    });
                }, 400);
            };

            // 공지사항 렌더링 로직
            const noticeListContainer = document.getElementById('notice-list-container');
            const notices = [
                { id: 1, title: "2026학년도 1학기 수강신청 안내", date: "2026.02.15", author: "교무처", content: "2026학년도 1학기 수강신청 일정 및 유의사항을 안내해 드립니다.<br>자세한 사항은 첨부파일을 확인해 주세요.", important: true },
                { id: 2, title: "ClassWay 서비스 오픈 이벤트", date: "2026.03.02", author: "학생회", content: "ClassWay 서비스가 드디어 정식 오픈했습니다!<br>오류 제보나 기능 개선 의견을 소통 게시판에 남겨주시면 추첨을 통해 커피 기프티콘을 드립니다.", important: true },
                { id: 3, title: "중간고사 기간 도서관 연장 운영", date: "2026.04.10", author: "중앙도서관", content: "중간고사 기간 동안 중앙도서관 열람실을 24시간 연장 운영합니다.<br>이용에 참고하시기 바랍니다.", important: false },
                { id: 4, title: "캠퍼스 내 전동 킥보드 안전 수칙", date: "2026.03.20", author: "학생처", content: "안전한 캠퍼스 조성을 위해 전동 킥보드 이용 시 안전 수칙을 준수해 주시기 바랍니다.<br>헬멧 착용 필수, 지정 구역 주차를 부탁드립니다.", important: false },
                { id: 5, title: "IT대학 1층 공용 PC 점검 안내", date: "2026.04.28", author: "정보전산원", content: "PC 최적화 및 윈도우 업데이트를 위해 이번 주말 공용 PC 점검이 있을 예정입니다.<br>점검 기간 중에는 3층 공용 PC실을 이용해 주세요.", important: false }
            ];

            const renderNotices = () => {
                if (!noticeListContainer) return;
                noticeListContainer.innerHTML = '';
                notices.forEach(notice => {
                    const badge = notice.important ? '<span class="notice-badge important">📌 중요</span>' : '<span class="notice-badge">안내</span>';
                    const noticeHTML = `
                        <div class="notice-item">
                            <div class="notice-header">
                                <div class="notice-header-left">
                                    ${badge}
                                    <div class="notice-subject">${notice.title}</div>
                                </div>
                                <div class="notice-date">${notice.date}</div>
                            </div>
                            <div class="notice-body">
                                ${notice.content}<br><br><small style="color: #95a5a6;">작성자: ${notice.author}</small>
                            </div>
                        </div>
                    `;
                    noticeListContainer.insertAdjacentHTML('beforeend', noticeHTML);
                });

                // 아코디언 이벤트 추가
                document.querySelectorAll('.notice-item').forEach(item => {
                    const header = item.querySelector('.notice-header');
                    header.addEventListener('click', () => {
                        const isExpanded = item.classList.contains('expanded');
                        // 모든 아코디언 닫기
                        document.querySelectorAll('.notice-item').forEach(el => el.classList.remove('expanded'));
                        // 클릭한 요소가 닫혀있었다면 열기
                        if (!isExpanded) {
                            item.classList.add('expanded');
                        }
                    });
                });
            };
            renderNotices();

            const aiPromptInput = document.querySelector('.ai-prompt-input');
            const sendPromptBtn = document.querySelector('.send-prompt-btn');
            const aiGreeting = document.getElementById('ai-greeting');
            const chatHistory = document.getElementById('chat-history');
            const contentContainer = document.getElementById('home-content');

            // 🌟 여기서부터 새로 바뀐 백엔드 연동 코드입니다 🌟
            const sendMainChatMessage = () => {
                const message = aiPromptInput.value.trim();
                const hasFiles = selectedFiles.length > 0;

                if (!message && !hasFiles) return; // 아무것도 없으면 실행 안 함

                // 1. UI 상태 변경 (채팅창 열기)
                aiGreeting.style.display = 'none';
                contentContainer.classList.add('chat-active');
                chatHistory.classList.remove('hidden');

                // 2. 사용자 메시지 말풍선 추가
                const userMessageDiv = document.createElement('div');
                userMessageDiv.classList.add('chat-message', 'user-message');
                userMessageDiv.textContent = message || "(파일 첨부됨)";
                chatHistory.appendChild(userMessageDiv);

                // 3. AI 답변 대기 말풍선(로딩 상태) 미리 추가
                const aiResponseDiv = document.createElement('div');
                aiResponseDiv.classList.add('chat-message', 'ai-message');
                aiResponseDiv.textContent = "답변을 준비 중입니다...";
                chatHistory.appendChild(aiResponseDiv);

                chatHistory.scrollTop = chatHistory.scrollHeight;

                // ==========================================
                // 🚀 백엔드 연동 부분 (파일이 있을 때)
                // ==========================================
                if (hasFiles) {
                    aiResponseDiv.textContent = "PDF를 분석하여 퀴즈를 생성하고 있습니다. (시간이 조금 걸릴 수 있습니다...)";

                    const myFile = selectedFiles[0]; // 첨부된 첫 번째 파일 가져오기
                    const formData = new FormData();
                    formData.append('file', myFile); // 백엔드가 요구한 'file' 이름표 달기

                    fetch('http://localhost:7000/quiz/generate', {
                        method: 'POST',
                        headers: {
                            'Authorization': 'Bearer ' + (localStorage.getItem('admin_token') || '')
                        },
                        body: formData
                    })
                        .then(response => {
                            if (!response.ok) throw new Error('서버 응답 오류');
                            return response.json();
                        })
                        .then(data => {
                            console.log("백엔드 응답 성공:", data);
                            // 도착한 JSON 데이터를 채팅창에 표시
                            aiResponseDiv.innerHTML = `<strong>🎉 퀴즈 생성 완료!</strong><br><br><pre style="white-space: pre-wrap; font-family: inherit; margin: 0;">${JSON.stringify(data, null, 2)}</pre>`;
                            chatHistory.scrollTop = chatHistory.scrollHeight;
                        })
                        .catch(error => {
                            console.error("전송 실패:", error);
                            aiResponseDiv.textContent = "퀴즈 생성에 실패했습니다. 백엔드 서버가 켜져 있는지 확인해주세요.";
                        });

                    // 전송 후 파일 입력창 초기화
                    fileUpload.value = '';
                    selectedFiles = [];
                    renderFileList();

                } else {
                    // ==========================================
                    // 기존 로직 (파일 없이 텍스트만 쳤을 때: 빈 강의실 안내)
                    // ==========================================
                    setTimeout(() => {
                        const mockBackendResponse = {
                            status: "success",
                            timestamp: "현재 시간",
                            empty_classrooms: {
                                "1": ["101호", "103호", "107호"],
                                "2": ["202호", "210호"],
                                "3": ["305호"]
                            }
                        };

                        let floorsHtml = '';
                        Object.entries(mockBackendResponse.empty_classrooms).forEach(([floor, rooms]) => {
                            const badgesHtml = rooms.map(room => `<span class="room-badge">${room}</span>`).join('');
                            floorsHtml += `<div class="floor-section">
                                    <div class="floor-title">${floor}층</div>
                                    <div class="room-badges">
                                        ${badgesHtml}
                                    </div>
                                </div>`;
                        });

                        aiResponseDiv.className = 'classroom-card';
                        aiResponseDiv.style.alignSelf = 'flex-start';
                        aiResponseDiv.style.maxWidth = '90%';
                        aiResponseDiv.innerHTML = `<div class="classroom-card-header">
                                🕒 ${mockBackendResponse.timestamp} 빈 강의실 목록
                            </div>
                            ${floorsHtml}
                            <button class="map-link-btn" onclick="document.getElementById('nav-classroom').click()">
                                지도에서 위치 확인하기
                            </button>`;
                        chatHistory.scrollTop = chatHistory.scrollHeight;
                    }, 600);
                }

                // 입력창 텍스트 초기화
                aiPromptInput.value = '';
            };
            // 🌟 백엔드 연동 코드 끝 🌟

            if (sendPromptBtn) {
                sendPromptBtn.addEventListener('click', sendMainChatMessage);
            }
            if (aiPromptInput) {
                aiPromptInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') sendMainChatMessage();
                });
            }

            if (classroomLink) {
                classroomLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    switchView(classroomView);
                    updateMobileNav(mNavClassroom);
                });
            }

            if (noticeLink) {
                noticeLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    switchView(noticeView);
                    updateMobileNav(mNavNotice);
                });
            }

            if (freeboardLink) {
                freeboardLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    switchView(boardView);
                    updateMobileNav(mNavBoard);
                });
            }

            const goHome = (e) => {
                e.preventDefault();
                switchView(homeView);
                updateMobileNav(mNavHome);
            };

            if (homeLink) homeLink.addEventListener('click', goHome);

            // 모바일 네비게이션 이벤트
            if (mNavHome) mNavHome.addEventListener('click', () => goHome(new Event('click')));
            if (mNavClassroom) mNavClassroom.addEventListener('click', () => { switchView(classroomView); updateMobileNav(mNavClassroom); });
            if (mNavNotice) mNavNotice.addEventListener('click', () => { switchView(noticeView); updateMobileNav(mNavNotice); });
            if (mNavBoard) mNavBoard.addEventListener('click', () => { switchView(boardView); updateMobileNav(mNavBoard); });

            // --- 소통 게시판 기능 구현 ---
            const postListContainer = document.getElementById('post-list-container');
            const fabWriteBtn = document.getElementById('fab-write-btn');
            const writePostModal = document.getElementById('writePostModal');
            const closeWriteModalBtn = document.getElementById('closeWriteModalBtn');
            const writeCancelBtn = document.getElementById('writeCancelBtn');
            const writeSubmitBtn = document.getElementById('writeSubmitBtn');

            const postTitleInput = document.getElementById('post-title-input');
            const postCategorySelect = document.getElementById('post-category-select');
            const postContentInput = document.getElementById('post-content-input');

            // 더미 데이터
            let posts = [
                { id: 1, author: "익명1", category: "💡 정보", title: "IT대학 프린터 어디서 쓰나요?", content: "1층에 있다고 들었는데 카드가 안먹혀요 ㅠㅠ", time: "10분 전", likes: 2, comments: 1 },
                { id: 2, author: "익명2", category: "☕ 잡담", title: "오늘 학식 메뉴 뭔가요?", content: "수업 늦게 끝나서 아직 못갔는데 돈까스 남았을까요?", time: "30분 전", likes: 5, comments: 3 },
                { id: 3, author: "컴공요정", category: "🙋‍♂️ 질문", title: "산학프로젝트 팀원 구합니다", content: "웹 프론트엔드 1명 구해요! 백엔드는 다 준비되어 있습니다.", time: "1시간 전", likes: 10, comments: 4 }
            ];

            const renderPosts = () => {
                if (!postListContainer) return;
                postListContainer.innerHTML = '';
                posts.forEach(post => {
                    const postHTML = `
                        <div class="post-item">
                            <div class="post-meta">
                                <div class="post-avatar">👤</div>
                                <div class="post-info">
                                    <span class="post-author">${post.author}</span>
                                    <span class="post-time">${post.time}</span>
                                </div>
                                <span class="post-category">${post.category}</span>
                            </div>
                            <h3 class="post-title">${post.title}</h3>
                            <div class="post-content">${post.content}</div>
                            <div class="post-footer">
                                <div class="post-action"><span>❤️</span> 좋아요 ${post.likes}</div>
                                <div class="post-action"><span>💬</span> 댓글 ${post.comments}</div>
                            </div>
                        </div>
                    `;
                    postListContainer.insertAdjacentHTML('beforeend', postHTML);
                });
            };

            // 모달 열기/닫기
            const toggleWriteModal = () => {
                if (!writePostModal) return;
                const isActive = writePostModal.classList.contains('active');
                if (isActive) {
                    writePostModal.classList.remove('active');
                    document.body.classList.remove('modal-open');
                } else {
                    writePostModal.classList.add('active');
                    document.body.classList.add('modal-open');
                }
            };

            if (fabWriteBtn) fabWriteBtn.addEventListener('click', toggleWriteModal);
            if (closeWriteModalBtn) closeWriteModalBtn.addEventListener('click', toggleWriteModal);
            if (writeCancelBtn) writeCancelBtn.addEventListener('click', toggleWriteModal);

            // 새 글 등록
            if (writeSubmitBtn) {
                writeSubmitBtn.addEventListener('click', () => {
                    const title = postTitleInput.value.trim();
                    const categoryOption = postCategorySelect.options[postCategorySelect.selectedIndex].text;
                    const content = postContentInput.value.trim();

                    if (!title || !content) {
                        alert("제목과 내용을 모두 입력해주세요!");
                        return;
                    }

                    const newPost = {
                        id: Date.now(),
                        author: "나(익명)",
                        category: categoryOption,
                        title: title,
                        content: content.replace(/\n/g, '<br>'),
                        time: "방금 전",
                        likes: 0,
                        comments: 0
                    };

                    posts.unshift(newPost); // 배열 맨 앞에 추가
                    renderPosts(); // 다시 그리기

                    // 폼 초기화 및 닫기
                    postTitleInput.value = '';
                    postContentInput.value = '';
                    toggleWriteModal();

                    // 스크롤 최상단으로 이동
                    boardView.scrollTop = 0;
                    window.scrollTo(0, 0);
                });
            }

            // 초기 렌더링
            renderPosts();
            if (logoLink) logoLink.addEventListener('click', goHome);

            // Floating Chatbot Extension Logic
            const floatingInput = document.getElementById('floating-ai-input');
            const floatingSendBtn = document.getElementById('floating-send-btn');
            const floatingHistory = document.getElementById('floating-chat-history');

            const sendFloatingMessage = () => {
                const msg = floatingInput.value.trim();
                if (!msg) return;

                const userDiv = document.createElement('div');
                userDiv.classList.add('chat-message', 'user-message');
                userDiv.textContent = msg;
                floatingHistory.appendChild(userDiv);
                floatingInput.value = '';
                floatingHistory.scrollTop = floatingHistory.scrollHeight;

                setTimeout(() => {
                    const mockBackendResponse = {
                        status: "success",
                        timestamp: msg + " 기준",
                        empty_classrooms: {
                            "1": ["102호"],
                            "2": ["201호", "208호"],
                            "3": ["302호", "303호"]
                        }
                    };

                    let floorsHtml = '';
                    Object.entries(mockBackendResponse.empty_classrooms).forEach(([floor, rooms]) => {
                        const badgesHtml = rooms.map(room => `<span class="room-badge">${room}</span>`).join('');
                        floorsHtml += `<div class="floor-section">
                                <div class="floor-title">${floor}층</div>
                                <div class="room-badges">
                                    ${badgesHtml}
                                </div>
                            </div>`;
                    });

                    const aiDiv = document.createElement('div');
                    aiDiv.className = 'classroom-card';
                    aiDiv.style.alignSelf = 'flex-start';
                    aiDiv.style.maxWidth = '90%';
                    aiDiv.innerHTML = `<div class="classroom-card-header">
                            🕒 ${mockBackendResponse.timestamp} 빈 강의실
                        </div>
                        ${floorsHtml}`;
                    floatingHistory.appendChild(aiDiv);
                    floatingHistory.scrollTop = floatingHistory.scrollHeight;
                }, 500);
            };

            if (floatingSendBtn) {
                floatingSendBtn.addEventListener('click', sendFloatingMessage);
            }
            if (floatingInput) {
                floatingInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') sendFloatingMessage();
                });
            }

            // Chatbot Toggle Icon Logic
            const chatbotToggleBtn = document.getElementById('chatbot-toggle-btn');
            const chatbotSection = document.getElementById('classroom-chatbot-section');
            if (chatbotToggleBtn && chatbotSection) {
                chatbotToggleBtn.addEventListener('click', () => {
                    chatbotSection.classList.toggle('active');
                    chatbotToggleBtn.classList.toggle('active');
                    if (chatbotToggleBtn.classList.contains('active')) {
                        chatbotToggleBtn.innerHTML = '✖';
                    } else {
                        chatbotToggleBtn.innerHTML = '🤖';
                    }
                });
            }

            // Search Toggle Icon Logic
            const searchToggleBtn = document.getElementById('search-toggle-btn');
            const searchSection = document.getElementById('classroom-search-section');
            if (searchToggleBtn && searchSection) {
                searchToggleBtn.addEventListener('click', () => {
                    searchSection.classList.toggle('active');
                    searchToggleBtn.classList.toggle('active');
                    if (searchToggleBtn.classList.contains('active')) {
                        searchToggleBtn.innerHTML = '✖';
                    } else {
                        searchToggleBtn.innerHTML = '🔍';
                    }
                });
            }

            // 강의실 검색 기능
            const pinLayer = document.getElementById('search-pin-layer');
            const runSearch = async () => {
                const searchInput = document.getElementById('map-room-search');
                if (!searchInput) return;
                const val = searchInput.value.trim();
                if (!val) return;
                try {
                    let data;
                    try {
                        const res = await fetch('./classrooms.json');
                        data = await res.json();
                    } catch (err) {
                        console.warn("fetch 실패(CORS 문제 등). 내장된 JSON 데이터를 사용합니다.", err);
                        // fallback data
                        data = {
                            "1": [
                                { "room": "1006-1", "type": "강의실", "x": 12.04, "y": 85.81 },
                                { "room": "1006-6", "type": "강의실", "x": 12.14, "y": 67.12 },
                                { "room": "1101", "type": "강의실", "x": 11.03, "y": 38.38 },
                                { "room": "1103 espace", "type": "강의실", "x": 22.34, "y": 38.15 },
                                { "room": "1204", "type": "강의실", "x": 17.40, "y": 20.54 },
                                { "room": "1209", "type": "강의실", "x": 27.89, "y": 20.77 },
                                { "room": "1210", "type": "강의실", "x": 36.53, "y": 20.54 },
                                { "room": "1213", "type": "강의실", "x": 45.68, "y": 20.09 },
                                { "room": "S space", "type": "특수목적공간", "x": 66.76, "y": 20.54 },
                                { "room": "1225", "type": "강의실", "x": 77.97, "y": 20.09 },
                                { "room": "1228", "type": "강의실", "x": 87.94, "y": 19.87 },
                                { "room": "I space", "type": "특수목적공간", "x": 61.31, "y": 43.12 },
                                { "room": "1122", "type": "강의실", "x": 70.46, "y": 43.12 },
                                { "room": "1125", "type": "강의실", "x": 79.31, "y": 42.67 },
                                { "room": "1128", "type": "강의실", "x": 88.25, "y": 42.67 }
                            ],
                            "2": [
                                { "room": "2104-2", "type": "강의실", "x": 11.95, "y": 83.07 },
                                { "room": "2105-2", "type": "강의실", "x": 26.35, "y": 82.62 },
                                { "room": "대회의실", "type": "특수목적공간", "x": 11.85, "y": 61.63 },
                                { "room": "2115-1", "type": "강의실", "x": 26.45, "y": 60.95 },
                                { "room": "TDM.space", "type": "특수목적공간", "x": 11.85, "y": 41.99 },
                                { "room": "2204", "type": "강의실", "x": 16.27, "y": 20.32 },
                                { "room": "2210 공용PC실3", "type": "강의실", "x": 32.83, "y": 20.54 },
                                { "room": "NHN", "type": "특수목적공간", "x": 43.11, "y": 19.87 },
                                { "room": "2221", "type": "강의실", "x": 66.83, "y": 20.50 },
                                { "room": "2225", "type": "강의실", "x": 78.01, "y": 20.27 },
                                { "room": "2228", "type": "강의실", "x": 87.86, "y": 20.05 },
                                { "room": "2119", "type": "강의실", "x": 61.49, "y": 42.34 },
                                { "room": "2122", "type": "강의실", "x": 70.21, "y": 42.34 },
                                { "room": "2125", "type": "강의실", "x": 79.14, "y": 42.12 },
                                { "room": "2128", "type": "강의실", "x": 87.96, "y": 42.12 }
                            ],
                            "3": [
                                { "room": "3108 IT홀", "type": "특수목적공간", "x": 24.40, "y": 75.85 },
                                { "room": "3208 공용PC실1", "type": "강의실", "x": 26.45, "y": 20.99 },
                                { "room": "3210 공용PC실2", "type": "강의실", "x": 41.57, "y": 21.22 },
                                { "room": "3120", "type": "강의실", "x": 63.47, "y": 42.67 },
                                { "room": "3124", "type": "강의실", "x": 75.19, "y": 42.21 },
                                { "room": "3128", "type": "강의실", "x": 86.81, "y": 42.44 },
                                { "room": "3224", "type": "강의실", "x": 74.99, "y": 20.32 },
                                { "room": "3228", "type": "강의실", "x": 86.71, "y": 20.09 }
                            ]
                        };
                    }

                    let target = null; let floorNum = '1';
                    for (const f of ["1", "2", "3"]) {
                        const found = (data[f] || []).find(r => r.room.includes(val));
                        if (found) { target = found; floorNum = f; break; }
                    }
                    if (target) {
                        const targetTab = document.querySelector(`.floor-tab[data-floor="${floorNum}"]`);
                        if (!targetTab.classList.contains('active')) targetTab.click();
                        setTimeout(() => {
                            if (pinLayer) {
                                pinLayer.innerHTML = `<div style="position: absolute; left: ${target.x}%; top: ${target.y}%; width: 18px; height: 18px; background: #E74C3C; border-radius: 50%; transform: translate(-50%, -50%); border: 3px solid white; animation: pulsePin 1.5s infinite; z-index: 1000;"><div style="position: absolute; top: -35px; left: 50%; transform: translateX(-50%); background: #333; color: white; padding: 5px 12px; border-radius: 6px; font-size: 12px; font-weight: bold; white-space: nowrap;">${target.room}</div></div>`;
                            }
                        }, 600);
                    } else { alert("찾을 수 없습니다."); }
                } catch (e) {
                    console.error(e);
                    alert("검색 중 오류가 발생했습니다.");
                }
            };

            const mapRoomSearchBtn = document.getElementById('map-room-search-btn');
            const mapRoomSearchInput = document.getElementById('map-room-search');
            if (mapRoomSearchBtn) {
                mapRoomSearchBtn.addEventListener('click', runSearch);
            }
            if (mapRoomSearchInput) {
                mapRoomSearchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        runSearch();
                    }
                });
            }

            // --- 인증(로그인/회원가입) 모달 및 백엔드 연동 로직 ---
            const topLoginBtn = document.getElementById('top-login-btn');
            const topSignupBtn = document.getElementById('top-signup-btn');

            const loginModal = document.getElementById('loginModal');
            const signupModal = document.getElementById('signupModal');

            const closeLoginModalBtn = document.getElementById('closeLoginModalBtn');
            const closeSignupModalBtn = document.getElementById('closeSignupModalBtn');

            // 토큰이 있다면 로그인 상태로 표시
            if (localStorage.getItem('admin_token') && topLoginBtn) {
                topLoginBtn.textContent = '로그아웃';
            }

            const toggleModal = (modal) => {
                if (!modal) return;
                const isActive = modal.classList.contains('active');
                if (!isActive) {
                    modal.classList.add('active');
                    document.body.classList.add('modal-open');
                } else {
                    modal.classList.remove('active');
                    document.body.classList.remove('modal-open');
                }
            };

            // 모달 열기 이벤트
            if (topLoginBtn) {
                topLoginBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    if (localStorage.getItem('admin_token')) {
                        // 로그아웃 처리
                        localStorage.removeItem('admin_token');
                        topLoginBtn.textContent = '로그인';
                        alert('로그아웃 되었습니다.');
                    } else {
                        toggleModal(loginModal);
                    }
                });
            }
            if (topSignupBtn) {
                topSignupBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    toggleModal(signupModal);
                });
            }

            // 닫기 버튼 이벤트
            if (closeLoginModalBtn) closeLoginModalBtn.addEventListener('click', () => toggleModal(loginModal));
            if (closeSignupModalBtn) closeSignupModalBtn.addEventListener('click', () => toggleModal(signupModal));

            // 회원가입 전송
            const signupSubmitBtn = document.getElementById('signupSubmitBtn');
            if (signupSubmitBtn) {
                signupSubmitBtn.addEventListener('click', () => {
                    const id = document.getElementById('signup-id-input').value.trim();
                    const pw = document.getElementById('signup-pw-input').value.trim();
                    if (!id || !pw) return alert('아이디와 비밀번호를 모두 입력해주세요.');

                    fetch('http://localhost:7000/admin/register', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ADMIN_ID: id, ADMIN_PW: pw, ADMIN_NAME: "새관리자" })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message && data.message.includes('성공')) {
                                alert('회원가입이 완료되었습니다. 이제 로그인해주세요!');
                                document.getElementById('signup-id-input').value = '';
                                document.getElementById('signup-pw-input').value = '';
                                toggleModal(signupModal);
                            } else {
                                alert('가입 실패: ' + (data.message || '오류 발생'));
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            alert('서버와 연결할 수 없습니다. DB와 서버가 켜져있는지 확인하세요.');
                        });
                });
            }

            // 로그인 전송
            const loginSubmitBtn = document.getElementById('loginSubmitBtn');
            if (loginSubmitBtn) {
                loginSubmitBtn.addEventListener('click', () => {
                    const id = document.getElementById('login-id-input').value.trim();
                    const pw = document.getElementById('login-pw-input').value.trim();
                    if (!id || !pw) return alert('아이디와 비밀번호를 모두 입력해주세요.');

                    fetch('http://localhost:7000/admin/login', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ ADMIN_ID: id, ADMIN_PW: pw })
                    })
                        .then(res => {
                            if (!res.ok) throw new Error('로그인 실패');
                            return res.json();
                        })
                        .then(data => {
                            if (data.token) {
                                localStorage.setItem('admin_token', data.token);
                                alert('로그인 성공!');
                                document.getElementById('login-id-input').value = '';
                                document.getElementById('login-pw-input').value = '';
                                toggleModal(loginModal);
                                if (topLoginBtn) topLoginBtn.textContent = '로그아웃';
                            } else {
                                alert('로그인 실패: 아이디 또는 비밀번호를 확인하세요.');
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            alert('로그인에 실패했습니다. (DB 연결 또는 정보 불일치)');
                        });
                });
            }

            if (mainFloorMap) {
                mainFloorMap.addEventListener('mousedown', function (e) {
                    const rect = mainFloorMap.getBoundingClientRect();
                    console.log(`{ "room": "강의실명", "x": ${((e.clientX - rect.left) / rect.width * 100).toFixed(2)}, "y": ${((e.clientY - rect.top) / rect.height * 100).toFixed(2)} },`);
                });
            }
        });
    </script>
</body>

</html>
